# Sessão autenticada (cookies do representante legal) — nunca versionar
data/sessao/*.json
*.session.json

# Ambiente Python
.venv/
venv/
__pycache__/
*.pyc

# Downloads de autos de infração e relatórios de saída — dados sensíveis/locais
data/downloads/*
data/output/*
!data/downloads/.gitkeep
!data/output/.gitkeep

# PDFs de autos de infração (reais ou exemplos/modelos) — documentos da empresa, nunca versionar
*.pdf

# Prints e HTML capturado das telas do portal — contêm CPF/nome real do representante legal
prints/
codigos_site/
