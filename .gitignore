# Sessão autenticada (cookies do representante legal) — nunca versionar
data/sessao/*.json
*.session.json

# Ambiente Python
.venv/
venv/
__pycache__/
*.pyc

# Downloads de autos de infração e relatórios de saída — dados sensíveis/locais
data/downloads/*
data/output/*
!data/downloads/.gitkeep
!data/output/.gitkeep

# Logs dos workers (arquitetura de múltiplos workers, 17/09/2026) — podem
# conter números de auto/CNPJ, são locais/efêmeros, nunca versionar
data/logs/

# PDFs de autos de infração (reais ou exemplos/modelos) — documentos da empresa, nunca versionar
*.pdf

# Prints e HTML capturado das telas do portal — contêm CPF/nome real do representante legal
prints/
codigos_site/

# Configuração local por máquina/pessoa (25/09/2026) — pasta de destino
# escolhida manualmente por quem usa o robô; específica de cada
# instalação, nunca do projeto
data/config_local.json
